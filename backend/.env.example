# Copy to backend/.env for local development. In production these are set in Render.

# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=grimoire
JWT_SECRET=replace-with-output-of: python -c "import secrets; print(secrets.token_hex(32))"

# Optional
CORS_ORIGINS=http://localhost:3000
# Seed account created on startup when BOTH are set (used by the API tests).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-locally
